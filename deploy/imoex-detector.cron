# Daily-детектор аномальных объёмов MOEX.
# Ставится как /etc/cron.d/imoex-detector (владелец root, права 644).
#
# Считаем прошлый торговый день до открытия текущих торгов (основная сессия
# MOEX стартует в 09:50 MSK), чтобы отчёт лежал готовым к началу дня.
#
# Слотов несколько, потому что точное время публикации истории на ISS не
# гарантировано. Скрипт идемпотентный: отчёт за день делается и отправляется
# один раз, поздние слоты при готовом отчёте выходят молча. По будням: во
# вторник считается понедельник, в понедельник — пятница.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 5,6,7,8 * * 1-5 root /opt/imoex-anomaly/deploy/detector-cron.sh >> /var/log/imoex-detector.log 2>&1
